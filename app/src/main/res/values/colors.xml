    <!-- Console log-level colors and background - see values-night/colors.xml
         for the dark-theme overrides of console_background/log_info/log_response.
         log_command/log_success/log_warning/log_error/log_debug are the same
         in both themes (unchanged from their original dark-background values;
         they already read fine on a dark console and were left alone in the
         light one on request, though log_warning in particular is fairly
         faint against a light background). -->
    <color name="log_command">#4FC3F7</color>
    <color name="log_response">#455A64</color>
    <color name="log_info">#37474F</color>
    <color name="log_success">#66BB6A</color>
    <color name="log_warning">#FFCA28</color>
    <color name="log_error">#EF5350</color>
    <color name="log_debug">#B39DDB</color>
    <color name="console_background">@color/esp_surface_variant_light</color>
</resources>

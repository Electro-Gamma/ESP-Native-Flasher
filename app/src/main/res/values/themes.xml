<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.EspNativeFlasher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/esp_primary</item>
        <item name="colorOnPrimary">@color/esp_on_primary</item>
        <item name="colorPrimaryDark">@color/esp_primary_dark</item>
        <item name="colorSecondary">@color/esp_secondary</item>
        <item name="colorError">@color/esp_error</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ============== Reusable panel styles ============== -->

    <style name="Widget.EspFlasher.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Widget.EspFlasher.CardContent" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="TextAppearance.EspFlasher.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.EspFlasher.Warning" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/log_warning</item>
    </style>

</resources>

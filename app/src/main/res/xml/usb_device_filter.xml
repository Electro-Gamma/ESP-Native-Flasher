<?xml version="1.0" encoding="utf-8"?>
<!--
    Known USB-UART bridge VID/PID pairs (decimal, as required by the Android
    USB device-filter schema). This list only controls automatic app launch
    when a device is plugged in - UsbSerialManager still enumerates and
    matches devices at runtime independent of this filter, so devices
    missing from this list can still be opened manually via "Detect".
-->
<resources>
    <!-- Silicon Labs CP2102 / CP2102N / CP2104 / CP2109 -->
    <usb-device vendor-id="4292" product-id="60000" />

    <!-- WCH CH340 / CH341 (several PID variants seen in the wild) -->
    <usb-device vendor-id="6790" product-id="29987" />
    <usb-device vendor-id="6790" product-id="21795" />
    <usb-device vendor-id="6790" product-id="21794" />

    <!-- FTDI FT232R / FT230X -->
    <usb-device vendor-id="1027" product-id="24577" />
    <usb-device vendor-id="1027" product-id="24597" />

    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" product-id="8963" />

    <!-- Espressif native USB-Serial/JTAG (built into ESP32-S2/S3/C3/C6/H2) -->
    <usb-device vendor-id="12346" product-id="4097" />
    <usb-device vendor-id="12346" product-id="4098" />
    <usb-device vendor-id="12346" product-id="4100" />

    <!-- Arduino Hex Upload (io.espflasher.app.arduinohex) - Arduino boards'
         own official USB-CDC (Uno R3/Mega 2560 R3/Leonardo/Micro/etc.), plus
         USBasp. Vendor-only here (unlike the precise pairs above) matches
         the vendored arduino-hex-upload module's own device_filter.xml -
         official boards use many different product IDs across models, and
         this list only gates auto-launch, not what UsbaspManager/felHR85's
         driver can actually open. -->
    <usb-device vendor-id="9025" /> <!-- Arduino LLC -->
    <usb-device vendor-id="10755" /> <!-- Arduino SA -->
    <usb-device vendor-id="5824" product-id="1500" /> <!-- USBasp, VOTI shared VID/PID -->
    <usb-device vendor-id="1003" product-id="51124" /> <!-- USBasp, old/unofficial ATMEL-VID clones -->
</resources>
